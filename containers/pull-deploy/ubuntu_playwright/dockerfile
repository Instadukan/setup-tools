# =============================================================================
#   Multi-stage: Pre-install ONLY Chromium from official Playwright image
#   Final stage: Minimal Ubuntu + Node + git/tini + all required libs
#   Clones repo → runs START_CMD
# =============================================================================

# ─── Stage 1: Chromium-only installer ───────────────────────────────────────
FROM mcr.microsoft.com/playwright:v1.58.1-noble AS browser-installer

# Install only Chromium + deps (using npx to avoid PNPM global issues)
RUN npx -y playwright@1.58.0 install --with-deps chromium

# ─── Stage 2: Final runtime image ───────────────────────────────────────────
FROM ubuntu:24.04

# Install Node.js LTS (via NodeSource) + minimal utils
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        openssh-client \
        tini \
    && curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* \
    && apt-get clean autoclean

# Install pnpm globally
RUN corepack enable && \
    corepack prepare pnpm@latest --activate && \
    pnpm config set store-dir /pnpm-store

# Install ALL required system libraries for Chromium / Playwright
# This is the critical part that fixes "cannot open shared object file" errors
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        libglib2.0-0 \
        libnss3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libasound2t64 \
        libatspi2.0-0 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxrandr2 \
        libpango-1.0-0 \
        libcairo2 \
        libpangocairo-1.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxrender1 \
        libxtst6 \
        libxss1 \
        fonts-liberation \
        libappindicator3-1 \
        libnspr4 \
        wget \
        ca-certificates \
        fonts-noto-color-emoji \
        libfontconfig1 \
        libfreetype6 \
        libharfbuzz0b \
        libpng16-16 \
        libjpeg-turbo8 \
        libwebp7 \
        libexpat1 \
        libbz2-1.0 \
        liblzma5 \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/* \
    && apt-get clean autoclean


# Copy the ENTIRE browsers directory (preserves real folder names: chromium-1208, etc.)
COPY --from=browser-installer /ms-playwright /ms-playwright

# Optional debug: verify what we copied (remove after first successful build)
RUN echo "Playwright browsers copied:" && \
    ls -laR /ms-playwright | head -n 30 && \
    find /ms-playwright -type f -name chrome -exec ls -la {} \; || echo "chrome binary not found"

WORKDIR /app

# ─── Environment variables ──────────────────────────────────────────────────
ENV GIT_REPO_URL=""           \
    GIT_USER=""               \
    GIT_TOKEN=""              \
    START_CMD="npm start"     \
    GIT_CLONE_DEPTH=1         \
    PNPM_HOME="/pnpm"         \
    PATH="/pnpm:$PATH"        \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# ─── Entrypoint ─────────────────────────────────────────────────────────────
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]