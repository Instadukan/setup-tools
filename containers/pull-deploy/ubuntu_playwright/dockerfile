# =============================================================================
#   Stage 1: Install Chromium ONLY (strip everything else)
# =============================================================================
FROM mcr.microsoft.com/playwright:v1.58.0-jammy AS browser-installer

# Install Chromium and REMOVE all other browsers
RUN npx -y playwright@1.58.0 install chromium && \
    rm -rf /ms-playwright/firefox-* \
           /ms-playwright/webkit-* \
           /ms-playwright/.links \
           /ms-playwright/.registry

# =============================================================================
#   Stage 2: Final runtime image (Ubuntu minimal)
# =============================================================================
FROM ubuntu:24.04

# Core runtime + Node.js 20
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        tini \
        libglib2.0-0 \
        libnss3 \
        libatk1.0-0 \
        libatk-bridge2.0-0 \
        libcups2 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libasound2t64 \
        libatspi2.0-0 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxrandr2 \
        libpango-1.0-0 \
        libcairo2 \
        libpangocairo-1.0-0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxrender1 \
        libxtst6 \
        libxss1 \
        fonts-liberation \
        libfontconfig1 \
        libfreetype6 \
        libpng16-16 \
        libjpeg-turbo8 \
        libwebp7 \
        libexpat1 \
        libbz2-1.0 \
        liblzma5 \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy Chromium only (now small)
COPY --from=browser-installer /ms-playwright /ms-playwright

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH"

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node"]
